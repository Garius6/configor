// test_config_manager.ps — регрессионные тесты для config_manager.ps
// через std/тест.ps, читает реальный TOML-файл во временном каталоге
// (не мокает фс/toml).

импорт "config_manager.ps" как конфигуратор
импорт "тест" как т
импорт фс

функ путь_тестового_файла() -> Строка
    "/tmp/panos_configor_test.toml"
конец

функ написать_тестовый_файл() -> Пусто
    пер содержимое = "версия = \"1.2.3\"\nотладка = true\n\n[настройки.прокси]\nсервер = \"localhost\"\nпорт = 8080\n\n[[хабы]]\nсервер = \"hub-a\"\n\n[[хабы]]\nсервер = \"hub-b\"\n"
    фс.записать(путь_тестового_файла(), содержимое)
конец

функ старт() -> Пусто
    пер отчёт = т.новый_отчёт()
    написать_тестовый_файл()

    пер менеджер = конфигуратор.новый_менеджер_параметров()
    менеджер.установить_файл_параметров(путь_тестового_файла())
    пер рез_чтения = менеджер.прочитать()
    т.проверить(отчёт, не рез_чтения.ошибка(), "прочитать() валидный TOML прошёл")

    т.равны(отчёт, менеджер.параметр_строка("версия", "?"), "1.2.3", "плоский строковый ключ верхнего уровня")
    т.равны(отчёт, менеджер.параметр_булево("отладка", ложь), истина, "плоский булевый ключ верхнего уровня")
    т.равны(отчёт, менеджер.параметр_строка("настройки.прокси.сервер", "?"), "localhost", "составной ключ через вложенную таблицу")
    т.равны(отчёт, менеджер.параметр_число("настройки.прокси.порт", 0), 8080, "составной числовой ключ через вложенную таблицу")
    т.равны(отчёт, менеджер.параметр_строка("хабы.0.сервер", "?"), "hub-a", "составной ключ с индексом массива [0]")
    т.равны(отчёт, менеджер.параметр_строка("хабы.1.сервер", "?"), "hub-b", "составной ключ с индексом массива [1]")

    т.равны(отчёт, менеджер.параметр_строка("настройки.прокси.нет_такого", "по-умолчанию"), "по-умолчанию", "отсутствующий ключ — значение по умолчанию")
    т.равны(отчёт, менеджер.параметр_строка("хабы.99.сервер", "нет"), "нет", "индекс за границей массива — значение по умолчанию")
    т.равны(отчёт, менеджер.параметр_число("версия", 0), 0, "неверный тип (Строка вместо Число) — значение по умолчанию")

    пер непрочитанный = конфигуратор.новый_менеджер_параметров()
    т.равны(отчёт, непрочитанный.параметр_строка("что-угодно", "нет данных"), "нет данных", "параметр без предварительного прочитать() — значение по умолчанию, не паника")

    пер рез_отсутствующего_файла = конфигуратор.новый_менеджер_параметров()
    рез_отсутствующего_файла.установить_файл_параметров("/tmp/panos_configor_test_НЕСУЩЕСТВУЕТ.toml")
    т.проверить(отчёт, рез_отсутствующего_файла.прочитать().ошибка(), "прочитать() несуществующего файла — Результат.Неудача")

    т.напечатать_сводку(отчёт)
    фс.удалить_директорию(путь_тестового_файла())
    если отчёт.провалено > 0 тогда
        паника("test_config_manager.ps: есть провалившиеся проверки")
    конец
конец
