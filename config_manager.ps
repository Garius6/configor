// config_manager.ps — доступ к конфигурации по составному ключу
// ("Настройки.Прокси.Сервер", включая индексы массива —
// "Хабы.0.Сервер"), порт назначения oscript-library/configor
// (класс МенеджерПараметров).
//
// Частичное покрытие (см. panos/specs/004-gitsync-dependency-packages/
// spec.md): оригинал — это набор ИСТОЧНИКОВ (json/yaml/vault/env/
// cmdline) с приоритетами слияния + декларативный конструктор
// параметров (Конструктор.НовыеПараметры()...). Здесь — только то, чего
// НЕТ в std/кодирование/toml.ps (тот уже разбирает TOML и даёт
// одноуровневый Значение.поле()/.элемент()): рекурсивный обход
// составного ключа по точкам + безопасный доступ со значением по
// умолчанию. yaml/vault/env/cmdline-провайдеры и декларативный
// конструктор параметров НЕ портированы — не запрошены, добавятся при
// реальном переносе gitsync, если понадобятся (Principle II).

импорт фс
импорт строки
импорт "кодирование/toml" как томл

экспорт тип МенеджерПараметров = структура
    путь_файла: Строка
    данные:     Опция(томл.Значение)
конец

/// Новый менеджер без файла и без прочитанных данных.
экспорт функ новый_менеджер_параметров() -> МенеджерПараметров
    МенеджерПараметров("", Опция.Нет())
конец

// Обходит сегменты составного ключа ("а.б.0.в") по дереву томл.Значение:
// числовой сегмент — индекс массива (Значение.элемент), иначе — поле
// таблицы (Значение.поле). Останавливается на первом ненайденном сегменте.
функ обойти_путь(корень: томл.Значение, путь_ключа: Строка) -> Опция(томл.Значение)
    пер сегменты = строки.разбить(путь_ключа, ".")
    пер текущее = корень
    для сегмент в сегменты цикл
        пер как_число = строки.в_число(сегмент)
        если не как_число.ошибка() тогда
            пер следующее = текущее.элемент(Целое(как_число.значение()))
            если не следующее.есть() тогда
                возврат Опция.Нет()
            конец
            текущее = следующее.значение()
        конец
        если как_число.ошибка() тогда
            пер следующее = текущее.поле(сегмент)
            если не следующее.есть() тогда
                возврат Опция.Нет()
            конец
            текущее = следующее.значение()
        конец
    конец
    Опция.Есть(текущее)
конец

реализация МенеджерПараметров

    функ установить_файл_параметров(это: МенеджерПараметров, путь: Строка) -> Пусто
        это.путь_файла = путь
    конец

    /// Читает и разбирает TOML-файл, установленный установить_файл_параметров.
    функ прочитать(это: МенеджерПараметров) -> Результат(Число, Ошибка)
        пер прочитанный_текст = фс.прочитать(это.путь_файла)
        если прочитанный_текст.ошибка() тогда
            возврат Результат.Неудача(прочитанный_текст.причина())
        конец

        пер разобранное = томл.разобрать(прочитанный_текст.значение())
        если разобранное.ошибка() тогда
            возврат Результат.Неудача(разобранное.причина())
        конец

        это.данные = Опция.Есть(разобранное.значение())
        Результат.Успех(0)
    конец

    /// Значение по составному ключу ("а.б.0.в") или Опция.Нет, если путь/файл не прочитан.
    функ параметр(это: МенеджерПараметров, путь_ключа: Строка) -> Опция(томл.Значение)
        если не это.данные.есть() тогда
            возврат Опция.Нет()
        конец
        обойти_путь(это.данные.значение(), путь_ключа)
    конец

    /// Строковое значение по ключу или по_умолчанию, если ключ отсутствует/не строка.
    функ параметр_строка(это: МенеджерПараметров, путь_ключа: Строка, по_умолчанию: Строка) -> Строка
        пер найденное = это.параметр(путь_ключа)
        если не найденное.есть() тогда
            возврат по_умолчанию
        конец
        найденное.значение().как_строку().получить(по_умолчанию)
    конец

    /// Числовое значение по ключу или по_умолчанию, если ключ отсутствует/не число.
    функ параметр_число(это: МенеджерПараметров, путь_ключа: Строка, по_умолчанию: Число) -> Число
        пер найденное = это.параметр(путь_ключа)
        если не найденное.есть() тогда
            возврат по_умолчанию
        конец
        найденное.значение().как_число().получить(по_умолчанию)
    конец

    /// Булево значение по ключу или по_умолчанию, если ключ отсутствует/не булево.
    функ параметр_булево(это: МенеджерПараметров, путь_ключа: Строка, по_умолчанию: Булево) -> Булево
        пер найденное = это.параметр(путь_ключа)
        если не найденное.есть() тогда
            возврат по_умолчанию
        конец
        найденное.значение().как_булево().получить(по_умолчанию)
    конец

конец
