импорт "ввод_вывод" как ио
импорт "config_manager.ps" как конфигуратор

функ старт() -> Пусто
    пер менеджер = конфигуратор.новый_менеджер_параметров()
    менеджер.установить_файл_параметров("pan.toml")
    менеджер.прочитать()
    ио.строка("имя пакета из pan.toml: \(менеджер.параметр_строка("имя", "?"))")
конец
